# 模型提供方模式: gateway (Java模型网关) | openai (公共OpenAI兼容API) | mock (本地离线规则+模拟流式)
LLM_PROVIDER=mock

# Java AI 模型接入与网关平台配置
GATEWAY_BASE_URL=http://localhost:8080/v1
GATEWAY_API_KEY=sk-gateway-local-dev
GATEWAY_MODEL=gpt-4o-mini
GATEWAY_EMBEDDING_MODEL=text-embedding-3-small

# 公共 OpenAI 兼容 API 配置 (切换 LLM_PROVIDER=openai 时生效)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 网关请求与 429 退避策略
GATEWAY_TIMEOUT_SECONDS=30.0
GATEWAY_MAX_RETRIES=3
GATEWAY_BACKOFF_BASE=0.5
GATEWAY_BACKOFF_MAX=8.0
ALLOW_MOCK_FALLBACK=true

# RAG 与 Qdrant 配置
QDRANT_MODE=memory
QDRANT_PATH=./data/qdrant_local
QDRANT_COLLECTION=logops_knowledge
EMBEDDING_BACKEND=local
EMBEDDING_DIM=256

# Agent 状态机限制
AGENT_MAX_STEPS=8
AGENT_TOKEN_BUDGET=6000
AGENT_RELEVANCE_THRESHOLD=0.45
